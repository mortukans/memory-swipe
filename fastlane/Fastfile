# Build Memory Swipe on a GitHub macOS runner and upload to TestFlight.
# No Apple ID password anywhere: everything runs through an App Store Connect API key.
#
# Required env (GitHub secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (contents of the .p8), APPLE_TEAM_ID,
#   DIST_CERT_P12 (base64 .p12), DIST_CERT_PASSWORD, DIST_CERT_ID
# The Xcode project is generated on the runner by `npx expo prebuild` before this runs.

require "base64"

default_platform(:ios)

APP_ID    = "com.mortukans.memoryswipe"
APP_NAME  = "Memory Swipe"
XCODEPROJ = "ios/MemorySwipe.xcodeproj"
WORKSPACE = "ios/MemorySwipe.xcworkspace"
SCHEME    = "MemorySwipe"

platform :ios do
  desc "Build a signed App Store IPA and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house: false,
    )

    setup_ci # temporary keychain on the runner

    # Bundle id (no special capabilities: photo-library access is just an Info.plist key).
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    bundle = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: APP_ID }).find { |b| b.identifier == APP_ID }
    unless bundle
      UI.message("Registering bundle id #{APP_ID}")
      bundle = Spaceship::ConnectAPI::BundleId.create(name: "Memory Swipe", platform: "IOS", identifier: APP_ID)
    end

    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("No App Store Connect app for #{APP_ID}. Create it in App Store Connect → My Apps → + (bundle id #{APP_ID}).") unless app
    UI.success("App record ready: #{app.name} (#{app.id})")

    # Distribution certificate from the persisted secret (same cert as the other app is fine).
    p12 = File.expand_path("dist.p12")
    File.binwrite(p12, Base64.decode64(ENV.fetch("DIST_CERT_P12")))
    import_certificate(certificate_path: p12, certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
                       keychain_path: File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"), keychain_password: "")

    # App Store provisioning profile for the bundle id.
    sigh(api_key: api_key, app_identifier: APP_ID, team_id: ENV.fetch("APPLE_TEAM_ID"), force: true,
         skip_certificate_verification: true, cert_id: ENV["DIST_CERT_ID"])

    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      bundle_identifier: APP_ID,
      targets: [SCHEME],
    )

    increment_build_number(xcodeproj: XCODEPROJ, build_number: ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M")))

    gym(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "MemorySwipe.ipa",
      xcargs: "-allowProvisioningUpdates",
      export_options: { provisioningProfiles: { APP_ID => lane_context[SharedValues::SIGH_NAME] } },
    )

    pilot(
      api_key: api_key,
      ipa: "build/MemorySwipe.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "Automated build #{ENV['BUILD_NUMBER']}",
    )
  end
end
